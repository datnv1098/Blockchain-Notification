# --- ALERT THRESHOLD ---
# Minimum USD value to trigger an alert (default: 50000)
ALERT_THRESHOLD_USD=50000

# --- TIME WINDOW FILTER ---
# Chỉ kiểm tra token được nhận trong N ngày gần nhất (default: 60 = ~2 tháng)
# Token được nhận trước đó sẽ bị bỏ qua
